# ==============================================================================
# Slash Admin (Frontend) Configuration Example
# ==============================================================================

# Backend API IP & URL (Change this to your server IP, e.g. http://192.168.1.50:8000)
VITE_BACKEND_URL=http://localhost:8000

# Application Routing & Base Paths
VITE_APP_DEFAULT_ROUTE=/erp/dashboard
VITE_APP_API_BASE_URL=/api
VITE_APP_ROUTER_MODE=frontend
VITE_APP_PUBLIC_PATH=/
