# ==============================================================================
# EEU Healthcare Management System - Backend Environment Configuration Example
# Copy this file to .env and configure your values.
# ==============================================================================

# Server Network & IP Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True

# Django Core
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-eeu-healthcare-system-secret-key-2026

# Mail Server Configuration
# Use console backend for testing, or smtp.SMTPBackend for production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=EEU Healthcare Portal <noreply@healthcare.local>

# Database
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
